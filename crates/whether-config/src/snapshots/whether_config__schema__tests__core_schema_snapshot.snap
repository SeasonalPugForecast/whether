---
source: crates/whether-config/src/schema.rs
expression: to_pretty_json(&core_schema())
---
{
  "$defs": {
    "AcisToml": {
      "additionalProperties": false,
      "description": "`[history.acis]`.",
      "properties": {
        "base_url": {
          "description": "API base URL.",
          "type": "string"
        },
        "records_station": {
          "description": "A station id for the records (`\"LGAthr\"`, a city's threaded record)\ninstead of the station's own threaded record.",
          "type": "string"
        },
        "station": {
          "description": "A station id to use instead of the nearest suitable one (`\"LGA\"`,\n`\"USW00014732\"`; `whether history --station` lists them).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "AqiScalePref": {
      "description": "The preferred air-quality index.",
      "oneOf": [
        {
          "const": "us",
          "description": "US EPA AQI.",
          "type": "string"
        },
        {
          "const": "european",
          "description": "European AQI.",
          "type": "string"
        }
      ]
    },
    "DailyIcon": {
      "description": "What a day's icon and condition describe.",
      "oneOf": [
        {
          "const": "daylight",
          "description": "The hours between sunrise and sunset, from the hourly forecast: rain at\n1 AM does not make a sunny day rainy. Days without hourly data use the\nprovider's.",
          "type": "string"
        },
        {
          "const": "provider",
          "description": "The provider's daily code (often the worst weather of all 24 hours).",
          "type": "string"
        }
      ]
    },
    "DateFormat": {
      "description": "How a calendar date is written, shown for 1 November (month names come from\nthe active strings).",
      "oneOf": [
        {
          "const": "mmm d",
          "description": "`Nov 1`.",
          "type": "string"
        },
        {
          "const": "d mmm",
          "description": "`1 Nov`.",
          "type": "string"
        },
        {
          "const": "MMMd",
          "description": "`NOV1`.",
          "type": "string"
        },
        {
          "const": "m/d",
          "description": "`11/1`.",
          "type": "string"
        },
        {
          "const": "mm/dd",
          "description": "`11/01`.",
          "type": "string"
        },
        {
          "const": "d/m",
          "description": "`1/11`.",
          "type": "string"
        },
        {
          "const": "dd/mm",
          "description": "`01/11`.",
          "type": "string"
        },
        {
          "const": "dd.mm.",
          "description": "`01.11.`.",
          "type": "string"
        },
        {
          "const": "yyyy-mm-dd",
          "description": "`2026-11-01`.",
          "type": "string"
        }
      ]
    },
    "DetailKind": {
      "description": "One card in the details widget.",
      "enum": [
        "wind",
        "gusts",
        "humidity",
        "dew_point",
        "pressure",
        "uv",
        "visibility",
        "cloud_cover",
        "precipitation",
        "feels_like",
        "normals",
        "records"
      ],
      "type": "string"
    },
    "DisplayTables": {
      "additionalProperties": {
        "type": "object"
      },
      "description": "`[display]`: `default` plus one table per display plugin (added by [`compose`]).",
      "properties": {
        "default": {
          "description": "The display used when none is named on the command line.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DistanceUnit": {
      "description": "Distance display unit (visibility).",
      "oneOf": [
        {
          "const": "km",
          "description": "Kilometres.",
          "type": "string"
        },
        {
          "const": "mi",
          "description": "Miles.",
          "type": "string"
        }
      ]
    },
    "General": {
      "additionalProperties": false,
      "description": "`[general]`.",
      "properties": {
        "coordinate_precision": {
          "default": 3,
          "description": "Coordinate decimals sent to APIs (at most 4).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "date_format": {
          "$ref": "#/$defs/DateFormat",
          "default": "mmm d",
          "description": "How dates are written."
        },
        "language": {
          "default": "en",
          "description": "Language of geocoding results.",
          "type": "string"
        },
        "refresh": {
          "default": "15m",
          "description": "Fetch interval (minimum 5 minutes).",
          "pattern": "^(\\d+h)?(\\d+m)?(\\d+s)?$",
          "type": "string"
        },
        "time_format": {
          "$ref": "#/$defs/TimeFormat",
          "default": "24h",
          "description": "Clock style."
        },
        "units": {
          "$ref": "#/$defs/UnitSystem",
          "default": "auto",
          "description": "Unit system; `auto` follows the locale."
        }
      },
      "type": "object"
    },
    "HistoryConfig": {
      "additionalProperties": false,
      "description": "`[history]`: where past days, normals and records come from.",
      "properties": {
        "acis": {
          "$ref": "#/$defs/AcisToml",
          "default": {},
          "description": "`[history.acis]`: NOAA's Regional Climate Centers (US stations)."
        },
        "order": {
          "default": [
            "acis",
            "open-meteo"
          ],
          "description": "Sources in fallback order: \"acis\" (US stations) and \"open-meteo\"\n(anywhere; ERA5 normals, no records).",
          "items": {
            "$ref": "#/$defs/ProviderId"
          },
          "type": "array"
        },
        "supplement": {
          "default": [
            "open-meteo"
          ],
          "description": "Sources that fill what the first lacks (a day not yet reported).",
          "items": {
            "$ref": "#/$defs/ProviderId"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "HourlyMetric": {
      "description": "A series shown in the hourly widget.",
      "enum": [
        "temperature",
        "feels_like",
        "precip_probability",
        "precipitation",
        "wind",
        "humidity",
        "uv"
      ],
      "type": "string"
    },
    "LocationConfig": {
      "additionalProperties": false,
      "description": "One `[[location]]`: coordinates, a postal code, or a free-text query.",
      "properties": {
        "country": {
          "description": "ISO 3166-1 alpha-2 country code.",
          "type": "string"
        },
        "elevation": {
          "description": "Elevation in meters.",
          "format": "float",
          "type": "number"
        },
        "latitude": {
          "description": "Latitude in degrees (with `longitude`).",
          "format": "double",
          "type": "number"
        },
        "longitude": {
          "description": "Longitude in degrees (with `latitude`).",
          "format": "double",
          "type": "number"
        },
        "name": {
          "description": "Display name (required, unique).",
          "type": "string"
        },
        "presentation": {
          "$ref": "#/$defs/PresentationToml",
          "description": "`[presentation]` keys that differ here, e.g. alerts only at home.\nThey apply over `[presentation]` and a display's own overrides."
        },
        "provider": {
          "$ref": "#/$defs/ProviderId",
          "description": "Provider override for this location."
        },
        "query": {
          "description": "Free-text place name resolved by geocoding.",
          "type": "string"
        },
        "timezone": {
          "description": "IANA zone, for providers that return none.",
          "type": "string"
        },
        "units": {
          "$ref": "#/$defs/UnitSystem",
          "description": "The unit system here (`\"metric\"` or `\"imperial\"`), instead of\n`[general] units` and `[units]`."
        },
        "utc_offset": {
          "description": "Fixed offset such as `\"-04:00\"`, for providers that return none.",
          "type": "string"
        },
        "zip": {
          "description": "Postal code (with `country`).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "MetNorwayToml": {
      "additionalProperties": false,
      "description": "`[providers.met-norway]`.",
      "properties": {
        "base_url": {
          "description": "API base URL.",
          "type": "string"
        },
        "contact": {
          "description": "Contact address sent in the User-Agent (required by MET Norway's terms).",
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/MetProduct",
          "description": "Forecast product."
        }
      },
      "type": "object"
    },
    "MetProduct": {
      "description": "MET Norway's forecast product.",
      "oneOf": [
        {
          "const": "complete",
          "description": "All variables.",
          "type": "string"
        },
        {
          "const": "compact",
          "description": "Fewer variables, smaller responses.",
          "type": "string"
        }
      ]
    },
    "ModelList": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        }
      ],
      "description": "Weather models in priority order: one id, or a list of up to 4."
    },
    "NwsCurrent": {
      "description": "`[providers.nws] current`.",
      "oneOf": [
        {
          "const": "observed",
          "description": "The nearest station's latest observation, when fresh (else the forecast).",
          "type": "string"
        },
        {
          "const": "forecast",
          "description": "The forecast for the current hour.",
          "type": "string"
        }
      ]
    },
    "NwsToml": {
      "additionalProperties": false,
      "description": "`[providers.nws]`: the US National Weather Service, forecasting in `order`\nand giving alerts as a supplement.",
      "properties": {
        "base_url": {
          "description": "API base URL.",
          "type": "string"
        },
        "current": {
          "$ref": "#/$defs/NwsCurrent",
          "description": "Where the current conditions come from when the NWS forecasts."
        }
      },
      "type": "object"
    },
    "OpenMeteoToml": {
      "additionalProperties": false,
      "description": "`[providers.open-meteo]`.",
      "properties": {
        "air_quality_url": {
          "description": "Air-quality API base URL.",
          "type": "string"
        },
        "api_key": {
          "$ref": "#/$defs/Secret",
          "description": "Key for commercial plans."
        },
        "base_url": {
          "description": "Forecast API base URL.",
          "type": "string"
        },
        "geocoding_url": {
          "description": "Geocoding API base URL.",
          "type": "string"
        },
        "models": {
          "$ref": "#/$defs/ModelList",
          "description": "Weather models in priority order: one id or a list."
        }
      },
      "type": "object"
    },
    "OpenWeatherToml": {
      "additionalProperties": false,
      "description": "`[providers.openweather]`.",
      "properties": {
        "api": {
          "$ref": "#/$defs/OwmApi",
          "description": "API flavor."
        },
        "api_key": {
          "$ref": "#/$defs/Secret",
          "description": "API key."
        },
        "base_url": {
          "description": "API base URL.",
          "type": "string"
        },
        "daily_call_limit": {
          "description": "One Call calls this device may make per UTC day (1–1000).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "OwmApi": {
      "description": "Which OpenWeather API a key is used with.",
      "oneOf": [
        {
          "const": "free",
          "description": "The free 2.5 endpoints.",
          "type": "string"
        },
        {
          "const": "onecall-3",
          "description": "One Call 3.0 (closed to new subscriptions; rejected by validation).",
          "type": "string"
        },
        {
          "const": "onecall-4",
          "description": "One Call 4.0 (\"One Call by Call\" subscription), metered by `daily_call_limit`.",
          "type": "string"
        }
      ]
    },
    "PirateWeatherToml": {
      "additionalProperties": false,
      "description": "`[providers.pirate-weather]`. Without the section, listing\n`\"pirate-weather\"` in `order` uses the defaults and the key from\n`PIRATE_WEATHER_API_KEY`.",
      "properties": {
        "ai_models": {
          "description": "Add the AI models (AIGFS, AIGEFS, ECMWF AIFS) to the blend.",
          "type": "boolean"
        },
        "api_key": {
          "$ref": "#/$defs/Secret",
          "description": "API key; default `{ env = \"PIRATE_WEATHER_API_KEY\" }`."
        },
        "base_url": {
          "description": "API base URL.",
          "type": "string"
        },
        "exclude_models": {
          "description": "Models to leave out of the blend (`\"gfs\"`, `\"hrrr\"`, …); the next best\nserves instead.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "monthly_call_limit": {
          "description": "Calls this device may make per UTC month (default 9000; the free key\nallows 10,000). Calls beyond it are never sent.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PrecipUnit": {
      "description": "Precipitation display unit.",
      "oneOf": [
        {
          "const": "mm",
          "description": "Millimetres.",
          "type": "string"
        },
        {
          "const": "in",
          "description": "Inches.",
          "type": "string"
        }
      ]
    },
    "PresentationToml": {
      "additionalProperties": false,
      "description": "`[presentation]` and `[display.<name>.presentation]`: each key overrides the\nbuilt-in default. Units and the clock style come from `[general]` and `[units]`.",
      "properties": {
        "aqi_scale": {
          "$ref": "#/$defs/AqiScalePref",
          "description": "Preferred air-quality index."
        },
        "daily_days": {
          "description": "Days in the daily widget (1–16).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "daily_hours": {
          "description": "Give each day its own hours, for displays that expand a day.",
          "type": "boolean"
        },
        "daily_icon": {
          "$ref": "#/$defs/DailyIcon",
          "description": "What a day's icon describes: `daylight` (sunrise to sunset, from the\nhourly forecast) or `provider` (the provider's daily code)."
        },
        "details": {
          "description": "Detail cards in order.",
          "items": {
            "$ref": "#/$defs/DetailKind"
          },
          "type": "array"
        },
        "history_days": {
          "description": "Days in the history widget (0–31).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "hourly_hours": {
          "description": "Hours in the hourly widget (1–48).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "hourly_metrics": {
          "description": "Series in the hourly widget.",
          "items": {
            "$ref": "#/$defs/HourlyMetric"
          },
          "type": "array"
        },
        "missing": {
          "description": "Placeholder for unavailable values.",
          "type": "string"
        },
        "nowcast_hours": {
          "description": "Hours the nowcast covers in 15-minute steps (1–8).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "precip_hours": {
          "description": "Hours in the precipitation table (1–48).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "precip_threshold": {
          "description": "Probability (%) treated as \"likely\".",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "show_unit_letter": {
          "description": "Show \"21 °C\" instead of \"21°\".",
          "type": "boolean"
        },
        "temperature_basis": {
          "$ref": "#/$defs/TemperatureBasis",
          "description": "Which temperature leads: `actual` or `feels_like` (the highs and lows\ntoo, where the data has them)."
        },
        "temperature_decimals": {
          "description": "Decimals for temperatures.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "twilight_minutes": {
          "description": "Minutes around sunrise and sunset that use the twilight theme.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "widgets": {
          "description": "Enabled widgets in order.",
          "items": {
            "$ref": "#/$defs/WidgetKind"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PressureUnit": {
      "description": "Pressure display unit.",
      "oneOf": [
        {
          "const": "hPa",
          "description": "Hectopascals.",
          "type": "string"
        },
        {
          "const": "inHg",
          "description": "Inches of mercury.",
          "type": "string"
        },
        {
          "const": "mmHg",
          "description": "Millimetres of mercury.",
          "type": "string"
        },
        {
          "const": "kPa",
          "description": "Kilopascals.",
          "type": "string"
        }
      ]
    },
    "ProviderId": {
      "description": "A weather data provider.",
      "oneOf": [
        {
          "const": "openweather",
          "description": "OpenWeather (openweathermap.org).",
          "type": "string"
        },
        {
          "const": "open-meteo",
          "description": "Open-Meteo (open-meteo.com).",
          "type": "string"
        },
        {
          "const": "met-norway",
          "description": "MET Norway (api.met.no).",
          "type": "string"
        },
        {
          "const": "nws",
          "description": "The US National Weather Service (api.weather.gov): official alerts as a\nsupplement, and the forecast as a primary provider.",
          "type": "string"
        },
        {
          "const": "acis",
          "description": "NOAA's Regional Climate Centers (data.rcc-acis.org): station history,\nnormals and records for US places; never a forecast.",
          "type": "string"
        },
        {
          "const": "pirate-weather",
          "description": "Pirate Weather (pirateweather.net): a keyed Dark Sky-style forecast from a\nblend of NOAA and other models, billed per month.",
          "type": "string"
        }
      ]
    },
    "ProvidersConfig": {
      "additionalProperties": false,
      "description": "`[providers]`.",
      "properties": {
        "met-norway": {
          "$ref": "#/$defs/MetNorwayToml",
          "description": "`[providers.met-norway]`."
        },
        "nws": {
          "$ref": "#/$defs/NwsToml",
          "default": {},
          "description": "`[providers.nws]`."
        },
        "open-meteo": {
          "$ref": "#/$defs/OpenMeteoToml",
          "default": {},
          "description": "`[providers.open-meteo]`."
        },
        "openweather": {
          "$ref": "#/$defs/OpenWeatherToml",
          "default": {
            "api": "free",
            "api_key": {
              "env": "OPENWEATHER_API_KEY"
            },
            "daily_call_limit": 900
          },
          "description": "`[providers.openweather]`."
        },
        "order": {
          "default": [
            "openweather",
            "open-meteo"
          ],
          "description": "Fallback chain; the first is the primary.",
          "items": {
            "$ref": "#/$defs/ProviderId"
          },
          "type": "array"
        },
        "pirate-weather": {
          "$ref": "#/$defs/PirateWeatherToml",
          "description": "`[providers.pirate-weather]`."
        },
        "supplement": {
          "default": [
            "open-meteo"
          ],
          "description": "Providers that fill what the primary lacks.",
          "items": {
            "$ref": "#/$defs/ProviderId"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RadarConfig": {
      "additionalProperties": false,
      "description": "`[radar]`: the radar imagery shown by the `radar` widget (Linux).",
      "properties": {
        "zoom": {
          "default": 8,
          "description": "Map zoom, 6 (several states) to 10 (a county); 8 is about 360 km across.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "RuntimeConfig": {
      "additionalProperties": false,
      "description": "`[runtime]`: Linux-only paths and logging.",
      "properties": {
        "cache_dir": {
          "description": "Cache directory (default `$XDG_CACHE_HOME/whether`).",
          "type": "string"
        },
        "log_file": {
          "description": "Log file for interactive displays (default `$XDG_STATE_HOME/whether/whether.log`).",
          "type": "string"
        },
        "log_level": {
          "description": "`error`, `warn`, `info`, `debug` or `trace`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Secret": {
      "description": "An API key: a literal string, or where to read it from.",
      "oneOf": [
        {
          "description": "The key itself (prefer { env = \"VAR\" }).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "env": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "env"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "file": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "TemperatureBasis": {
      "description": "Which temperature displays lead with.",
      "oneOf": [
        {
          "const": "actual",
          "description": "The air temperature; \"Feels like\" beside it.",
          "type": "string"
        },
        {
          "const": "feels_like",
          "description": "The \"feels like\" (apparent) temperature, the highs and lows too, where the\ndata has it; \"Actual\" beside it.",
          "type": "string"
        }
      ]
    },
    "TemperatureUnit": {
      "description": "Temperature display unit.",
      "oneOf": [
        {
          "const": "celsius",
          "description": "Degrees Celsius.",
          "type": "string"
        },
        {
          "const": "fahrenheit",
          "description": "Degrees Fahrenheit.",
          "type": "string"
        },
        {
          "const": "kelvin",
          "description": "Kelvin.",
          "type": "string"
        }
      ]
    },
    "TimeFormat": {
      "description": "Clock style for times of day.",
      "oneOf": [
        {
          "const": "24h",
          "description": "`14:00`.",
          "type": "string"
        },
        {
          "const": "12h",
          "description": "`2 PM`.",
          "type": "string"
        }
      ]
    },
    "UnitSystem": {
      "description": "The unit system selected in configuration.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Chosen from the locale (resolved in `whether-config`).",
          "type": "string"
        },
        {
          "const": "metric",
          "description": "°C, km/h, hPa, mm, km.",
          "type": "string"
        },
        {
          "const": "imperial",
          "description": "°F, mph, inHg, in, mi.",
          "type": "string"
        },
        {
          "const": "custom",
          "description": "Per-quantity units from the `[units]` table.",
          "type": "string"
        }
      ]
    },
    "UnitsOverride": {
      "additionalProperties": false,
      "description": "`[units]`: overrides applied on top of `general.units`.",
      "properties": {
        "distance": {
          "$ref": "#/$defs/DistanceUnit",
          "description": "Distance unit."
        },
        "precipitation": {
          "$ref": "#/$defs/PrecipUnit",
          "description": "Precipitation unit."
        },
        "pressure": {
          "$ref": "#/$defs/PressureUnit",
          "description": "Pressure unit."
        },
        "temperature": {
          "$ref": "#/$defs/TemperatureUnit",
          "description": "Temperature unit."
        },
        "wind": {
          "$ref": "#/$defs/WindUnit",
          "description": "Wind speed unit."
        }
      },
      "type": "object"
    },
    "WidgetKind": {
      "description": "A block of information that displays can show. Displays arrange them; the order\nhere is the user's preferred order.",
      "enum": [
        "current",
        "summary",
        "hourly",
        "daily",
        "details",
        "air_quality",
        "sun",
        "moon",
        "nowcast",
        "alerts",
        "radar",
        "precipitation",
        "history"
      ],
      "type": "string"
    },
    "WindUnit": {
      "description": "Wind speed display unit.",
      "oneOf": [
        {
          "const": "m/s",
          "description": "Metres per second.",
          "type": "string"
        },
        {
          "const": "km/h",
          "description": "Kilometres per hour.",
          "type": "string"
        },
        {
          "const": "mph",
          "description": "Miles per hour.",
          "type": "string"
        },
        {
          "const": "kn",
          "description": "Knots.",
          "type": "string"
        },
        {
          "const": "bft",
          "description": "Beaufort force number.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A whole configuration file, for the schema only (it mirrors `load::ConfigFile`).",
  "properties": {
    "display": {
      "$ref": "#/$defs/DisplayTables",
      "default": {}
    },
    "general": {
      "$ref": "#/$defs/General",
      "default": {
        "coordinate_precision": 3,
        "date_format": "mmm d",
        "language": "en",
        "refresh": "15m",
        "time_format": "24h",
        "units": "auto"
      }
    },
    "history": {
      "$ref": "#/$defs/HistoryConfig",
      "default": {
        "acis": {},
        "order": [
          "acis",
          "open-meteo"
        ],
        "supplement": [
          "open-meteo"
        ]
      }
    },
    "location": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LocationConfig"
      },
      "type": "array"
    },
    "presentation": {
      "$ref": "#/$defs/PresentationToml",
      "default": {}
    },
    "providers": {
      "$ref": "#/$defs/ProvidersConfig",
      "default": {
        "nws": {},
        "open-meteo": {},
        "openweather": {
          "api": "free",
          "api_key": {
            "env": "OPENWEATHER_API_KEY"
          },
          "daily_call_limit": 900
        },
        "order": [
          "openweather",
          "open-meteo"
        ],
        "supplement": [
          "open-meteo"
        ]
      }
    },
    "radar": {
      "$ref": "#/$defs/RadarConfig",
      "default": {
        "zoom": 8
      }
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig",
      "default": {}
    },
    "strings": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "units": {
      "$ref": "#/$defs/UnitsOverride",
      "default": {}
    },
    "version": {
      "default": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "whether configuration",
  "type": "object"
}
