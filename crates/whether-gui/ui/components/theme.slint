// Colors, sizes and the sky palettes. Rust sets the sky and palettes from config.

export global Theme {
    in-out property <color> sky-top: #2F80ED;
    in-out property <color> sky-bottom: #56CCF2;
    in-out property <color> text: #FFFFFF;
    in-out property <color> text-muted: #FFFFFFB3;
    in-out property <color> card: #FFFFFF22;
    in-out property <color> card-border: #FFFFFF33;
    in-out property <color> accent: #FFD166;
    in-out property <color> warning: #FFB020;
    in-out property <color> good: #4CAF50;
    in-out property <color> fair: #C0CA33;
    in-out property <color> moderate: #FFB300;
    in-out property <color> poor: #FB8C00;
    in-out property <color> very-poor: #E53935;
    in-out property <color> extreme: #8E24AA;
    in-out property <color> cold: #64B5F6;
    in-out property <color> cool: #81D4FA;
    in-out property <color> mild: #AED581;
    in-out property <color> warm: #FFB74D;
    in-out property <color> hot: #E57373;
    // Precipitation text: light enough to read on every sky.
    in-out property <color> rain: #E3F4FF;
    in-out property <length> radius: 16px;
    in-out property <length> spacing: 12px;
    in-out property <float> font-scale: 1.0;

    // A `Level` index (0 good … 5 extreme); anything else is muted.
    public pure function level-color(level: int) -> color {
        if level == 0 { return root.good; }
        if level == 1 { return root.fair; }
        if level == 2 { return root.moderate; }
        if level == 3 { return root.poor; }
        if level == 4 { return root.very-poor; }
        if level == 5 { return root.extreme; }
        root.text-muted
    }

    // Text on a `Level` color: dark, except on the deep purple of extreme.
    public pure function on-level(level: int) -> color {
        level >= 5 ? #FFFFFF : #1A1A1A
    }

    // A `TempLevel` index (0 freezing … 5 hot).
    public pure function temp-color(level: int) -> color {
        if level <= 1 { return root.cold; }
        if level == 2 { return root.cool; }
        if level == 3 { return root.mild; }
        if level == 4 { return root.warm; }
        root.hot
    }

    // Font size `px` scaled for full screen and kiosk.
    public pure function font(px: length) -> length {
        px * root.font-scale
    }
}
