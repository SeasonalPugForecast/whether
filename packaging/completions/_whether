'*-v[More logging (-v info, -vv debug, -vvv trace)]' \
'*--verbose[More logging (-v info, -vv debug, -vvv trace)]' \
'--watch[line and json\: print again on every change]' \
'--attach[Show data from a running \`whether daemon\` instead of fetching]' \
'-h[Print help (see more with '\''--help'\'')]' \
