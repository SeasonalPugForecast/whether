# A cross image for aarch64-unknown-linux-gnu on Debian bookworm, the base of Raspberry
# Pi OS, so glibc and the linked libraries match the Pi. It holds Debian's cross
# toolchain and the target libraries the GUI and kiosk builds link (fontconfig,
# libinput, udev, gbm, drm, xkbcommon). There is no qemu runner: user-mode qemu
# hangs on threads with a dynamically linked glibc here, so tests run on the Pi.
# `cargo xtask dist --target aarch64-unknown-linux-gnu` builds the image as
# whether-cross:aarch64-unknown-linux-gnu; Cross.toml points cross at it.
FROM debian:bookworm
RUN dpkg --add-architecture arm64 \
    && apt-get update \
    && apt-get install --assume-yes --no-install-recommends \
        ca-certificates build-essential crossbuild-essential-arm64 pkg-config \
        libfontconfig1-dev:arm64 libxkbcommon-dev:arm64 libinput-dev:arm64 \
        libudev-dev:arm64 libgbm-dev:arm64 libdrm-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
    PKG_CONFIG_ALLOW_CROSS=1
