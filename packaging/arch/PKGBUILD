# Maintainer: Sean Avery <pugforecast@gmail.com>
# Regenerate .SRCINFO after edits: makepkg --printsrcinfo > .SRCINFO

pkgname=whether
pkgver=0.1.0
pkgrel=1
pkgdesc='Weather for the terminal, the desktop and status bars'
arch=('x86_64' 'aarch64')
# Placeholder until the repository is published.
url='https://github.com/SeasonalPugForecast/whether'
license=('MIT')
depends=('fontconfig' 'gcc-libs' 'glibc' 'libxkbcommon')
makedepends=('cargo')
# makepkg's LTO flags turn ring's C objects into GCC bitcode that rust-lld can't link.
options=('!lto')
optdepends=('wayland: the GUI on Wayland'
            'libxkbcommon-x11: the GUI on X11'
            'libxcursor: the GUI on X11'
            'libglvnd: OpenGL rendering')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked --offline -p whether
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --locked --offline -p whether-core -p whether-config -p whether -p whether-runtime
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/whether -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/whether.desktop -t "$pkgdir/usr/share/applications/"
  local icon
  for icon in 128x128/apps/whether.png 256x256/apps/whether.png scalable/apps/whether.svg; do
    install -Dm644 "packaging/icons/hicolor/$icon" "$pkgdir/usr/share/icons/hicolor/$icon"
  done
  install -Dm644 packaging/man/whether.1 -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 packaging/completions/whether.bash "$pkgdir/usr/share/bash-completion/completions/whether"
  install -Dm644 packaging/completions/_whether -t "$pkgdir/usr/share/zsh/site-functions/"
  install -Dm644 packaging/completions/whether.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 packaging/systemd/whether-daemon.service -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 docs/config/whether.example.toml -t "$pkgdir/usr/share/doc/whether/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/whether/"
  # States how Slint and the bundled assets are licensed.
  install -Dm644 packaging/deb/copyright "$pkgdir/usr/share/licenses/whether/NOTICE"
}
